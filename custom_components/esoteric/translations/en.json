{
  "config": {
    "step": {
      "user": {
        "title": "Esoteric unit",
        "description": "Connect to an Esoteric unit through its RS-232C port.",
        "data": {
          "name": "Name",
          "connection": "Connection",
          "model": "Model",
          "baudrate": "Baud rate"
        },
        "data_description": {
          "name": "Optional. Defaults to the model name.",
          "connection": "`socket://host:port` for a raw TCP serial server (set 9600 8N1 on the server), `rfc2217://host:port` if the server lets clients set the baud rate (RFC 2217), or a local port such as `/dev/ttyUSB0` / `COM3`.",
          "model": "Models other than the N-05XD have not been tested on real hardware.",
          "baudrate": "Esoteric units use 9600. Only sent for rfc2217:// and local serial ports; for socket:// configure it on the serial server."
        }
      },
      "reconfigure": {
        "title": "Reconfigure Esoteric unit",
        "data": {
          "connection": "Connection",
          "model": "Model",
          "baudrate": "Baud rate"
        },
        "data_description": {
          "connection": "`socket://host:port` for a raw TCP serial server (set 9600 8N1 on the server), `rfc2217://host:port` if the server lets clients set the baud rate (RFC 2217), or a local port such as `/dev/ttyUSB0` / `COM3`.",
          "model": "Models other than the N-05XD have not been tested on real hardware.",
          "baudrate": "Esoteric units use 9600. Only sent for rfc2217:// and local serial ports; for socket:// configure it on the serial server."
        }
      }
    },
